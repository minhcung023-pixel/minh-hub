-- ================= KIỂM TRA =================
if not game or not game.GetService then
    warn("[minh fix lag] Không phải Roblox.")
    return
end

local ok, Workspace = pcall(function() return game:GetService("Workspace") end)
if not ok then
    warn("[minh fix lag] Không truy cập Workspace.")
    return
end

local Lighting         = game:GetService("Lighting")
local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then
    warn("[minh fix lag] Chưa có LocalPlayer. Vào game rồi chạy lại.")
    return
end

-- ================= CẤU HÌNH =================
local IS_MOBILE = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

local CONFIG = {
    KeyFix     = Enum.KeyCode.F,
    KeyGrass   = Enum.KeyCode.G,
    Batch      = IS_MOBILE and 150 or 400,
    DragLimit  = 8,
    GuiName    = "MinhFixLagGui",
    Debug      = true,
    -- Từ khóa nhận diện cỏ
    GrassNames = {
        "grass", "bush", "leaf", "leaves", "foliage", "plant",
        "shrub", "weed", "flower", "fern", "moss", "vine",
        "cỏ", "lá", "bụi",
    },
    GrassTextures = {
        "grass", "leaf", "leaves", "foliage", "plant", "bush",
    },
    GrassMaxSize = 12,   -- part nhỏ hơn 12 studs mới coi là cỏ
}

-- ================= TRẠNG THÁI =================
-- saved[part] = { Transparency, CanCollide, Material, Reflectance, CastShadow, children }
-- Mỗi part CHỈ lưu 1 lần duy nhất, dù bị ảnh hưởng bởi fix tổng hay ẩn cỏ.
local saved = {}

local flags = {
    fixOn   = true,   -- tối ưu tổng đang bật
    grassOn = true,   -- ẩn cỏ đang bật
    busy    = false,  -- đang quét
}

local stats = { parts = 0, grass = 0, lights = 0, particles = 0 }

-- ================= HELPERS =================
local function log(msg)
    if CONFIG.Debug then
        print("[minh fix lag]", msg)
    end
end

local function isPlayerChar(part)
    local model = part:FindFirstAncestorOfClass("Model")
    while model do
        if Players:GetPlayerFromCharacter(model) then return true end
        model = model:FindFirstAncestorOfClass("Model")
    end
    return false
end

local function nameIsGrass(name)
    local lower = name:lower()
    for _, p in ipairs(CONFIG.GrassNames) do
        if lower:find(p, 1, true) then return true end
    end
    return false
end

local function hasGrassTexture(part)
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("Texture") or child:IsA("Decal") then
            local tex = child.Texture
            if tex and tex ~= "" then
                local lower = tex:lower()
                for _, p in ipairs(CONFIG.GrassTextures) do
                    if lower:find(p, 1, true) then return true end
                end
            end
        end
    end
    return false
end

local function isGrass(part)
    if not part:IsA("BasePart") then return false end
    local sz = part.Size
    local maxDim = math.max(sz.X, sz.Y, sz.Z)
    if nameIsGrass(part.Name) and maxDim <= 20 then return true end
    if hasGrassTexture(part) and maxDim <= CONFIG.GrassMaxSize then return true end
    return false
end

-- Lưu trạng thái gốc của part (chỉ 1 lần)
local function savePart(part)
    if saved[part] then return end
    local children = {}
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("Texture") or child:IsA("Decal") then
            children[child] = child.Transparency
        end
    end
    saved[part] = {
        Transparency = part.Transparency,
        CanCollide   = part.CanCollide,
        Material     = part.Material,
        Reflectance  = part.Reflectance,
        CastShadow   = part.CastShadow,
        children     = children,
    }
end

-- Khôi phục part về trạng thái gốc
local function restorePart(part)
    local data = saved[part]
    if not data then return end
    pcall(function()
        part.Transparency = data.Transparency
        part.CanCollide   = data.CanCollide
        part.Material     = data.Material
        part.Reflectance  = data.Reflectance
        part.CastShadow   = data.CastShadow
        for child, t in pairs(data.children) do
            if child and child.Parent then
                child.Transparency = t
            end
        end
    end)
    saved[part] = nil
end

-- Ẩn cỏ
local function hideGrass(part)
    if not isGrass(part) then return false end
    savePart( flagspart)
    pcall(function()
        part.Transparency = 1
        part.CanCollide   = false
        part.CastShadow   = false
        for _, child in ipairs(part:GetChildren()) do
            if child:IsA("Texture") or child:IsA("Decal") then
                child.Transparency = 1
            end
        end
    end)
