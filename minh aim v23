local function makeESP(plr)
    if plr == LP then return end
    if ESPs[plr] then
        pcall(function() ESPs[plr].root:Destroy() end)
        ESPs[plr] = nil
    end

    -- Root container (chứa tên trên + box + khoảng cách dưới)
    local root = Instance.new("Frame")
    root.Name = "ESP_" .. plr.Name
    root.BackgroundTransparency = 1
    root.BorderSizePixel = 0
    root.ClipsDescendants = false
    root.Size = UDim2.new(0, CFG.boxW, 0, CFG.boxH + 35)
    root.Visible = false
    root.Parent = gui

    -- Box (cách top 18px cho tên)
    local box = Instance.new("Frame")
    box.Name = "Box"
    box.BackgroundColor3 = CFG.boxColor
    box.BackgroundTransparency = CFG.fillTransparency
    box.BorderSizePixel = 0
    box.Size = UDim2.new(1, 0, 0, CFG.boxH)
    box.Position = UDim2.new(0, 0, 0, 18)
    box.Parent = root

    -- 4 cạnh viền
    local function makeLine(name, size, pos)
        local f = Instance.new("Frame")
        f.Name = name
        f.BackgroundColor3 = CFG.boxColor
        f.BackgroundTransparency = CFG.boxTransparency
        f.BorderSizePixel = 0
        f.Size = size
        f.Position = pos
        f.Parent = box
    end
    makeLine("Top",    UDim2.new(1, 0, 0, 2), UDim2.new(0, 0, 0, 0))
    makeLine("Bottom", UDim2.new(1, 0, 0, 2), UDim2.new(0, 0, 1, -2))
    makeLine("Left",   UDim2.new(0, 2, 1, 0), UDim2.new(0, 0, 0, 0))
    makeLine("Right",  UDim2.new(0, 2, 1, 0), UDim2.new(1, -2, 0, 0))

    -- Thanh máu (bên trái box)
    local hpBg = Instance.new("Frame")
    hpBg.Name = "HPBg"
    hpBg.BackgroundColor3 = Color3.new(0, 0, 0)
    hpBg.BackgroundTransparency = 0.3
    hpBg.BorderSizePixel = 0
    hpBg.Size = UDim2.new(0, CFG.hpW, 1, 0)
    hpBg.Position = UDim2.new(0, -CFG.hpGap - CFG.hpW, 0, 0)
    hpBg.Parent = box

    local hpFill = Instance.new("Frame")
    hpFill.Name = "HPFill"
    hpFill.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
    hpFill.BackgroundTransparency = 0.2
    hpFill.BorderSizePixel = 0
    hpFill.Size = UDim2.new(1, 0, 1, 0)
    hpFill.Parent = hpBg

    -- Tên (trên cùng root)
    local nameLbl = Instance.new("TextLabel")
    nameLbl.Name = "Name"
    nameLbl.BackgroundTransparency = 1
    nameLbl.TextColor3 = CFG.boxColor
    nameLbl.TextStrokeTransparency = 0.4
    nameLbl.TextSize = 13
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.Size = UDim2.new(1, 0, 0, 15)
    nameLbl.Position = UDim2.new(0, 0, 0, 0)
    nameLbl.Text = plr.Name
    nameLbl.Parent = root

    -- Khoảng cách (dưới cùng root)
    local distLbl = Instance.new("TextLabel")
    distLbl.Name = "Dist"
    distLbl.BackgroundTransparency = 1
    distLbl.TextColor3 = Color3.fromRGB(220, 255, 220)
    distLbl.TextStrokeTransparency = 0.4
    distLbl.TextSize = 12
    distLbl.Font = Enum.Font.GothamBold
    distLbl.Size = UDim2.new(1, 0, 0, 14)
    distLbl.Position = UDim2.new(0, 0, 1, -14)
    distLbl.Text = "0m"
    distLbl.Parent = root

    ESPs[plr] = {
        root = root,
        box = box,
        hpBg = hpBg,
        hpFill = hpFill,
        nameLbl = nameLbl,
        distLbl = distLbl,
    }
end

local function removeESP(plr)
    if ESPs[plr] then
        pcall(function() ESPs[plr].root:Destroy() end)
        ESPs[plr] = nil
    end
end

