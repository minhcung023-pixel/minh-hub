end)

-- ═══════════════════════════════════════════════
-- UPDATE ESP MỖI FRAME
-- ═══════════════════════════════════════════════

RunService.RenderStepped:Connect(function()
    if not espOn then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local vp = cam.ViewportSize

    for plr, obj in pairs(ESPs) do
        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")

        if not (char and head and hum and hrp) or hum.Health <= 0 then
            obj.root.Visible = false
            continue
        end

        local dist = (cam.CFrame.Position - hrp.Position).Magnitude
        if dist > CFG.maxESP then
            obj.root.Visible = false
            continue
        end

        local headPos, onScreen = cam:WorldToViewportPoint(head.Position)
        if not onScreen then
            obj.root.Visible = false
            continue
        end

        -- Vùng ẩn rìa màn hình (nới rộng tránh nhấp nháy)
        if headPos.X < -CFG.boxW * 3 or headPos.X > vp.X + CFG.boxW * 3
           or headPos.Y < -CFG.boxH * 3 or headPos.Y > vp.Y + CFG.boxH * 3 then
            obj.root.Visible = false
            continue
        end

        obj.root.Visible = true

        -- Vị trí: đỉnh box = đỉnh đầu - 15px
        -- Root có offset 18px trước box → rootY = boxTopY - 18
        local boxTopY = headPos.Y - 15
        local rootY = boxTopY - 18
        local rootX = headPos.X - CFG.boxW / 2

        obj.root.Position = UDim2.fromOffset(rootX, rootY)

        -- Đổi màu theo trạng thái lock
        local isLocked = (plr == lockPlayer)
        local col = isLocked and CFG.lockColor or CFG.boxColor

        obj.box.BackgroundColor3 = col
        obj.box.BackgroundTransparency = CFG.fillTransparency
        for _, side in pairs(obj.box:GetChildren()) do
            if side:IsA("Frame") and side.Name ~= "HPBg" then
                side.BackgroundColor3 = col
                side.BackgroundTransparency = CFG.boxTransparency
            end
        end

        obj.nameLbl.TextColor3 = col
        obj.nameLbl.Text = isLocked and ("🔒 " .. plr.Name) or plr.Name

        obj.distLbl.TextColor3 = col
        obj.distLbl.Text = "[" .. math.floor(dist) .. "m]"

        -- Máu
        local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        obj.hpFill.Size = UDim2.new(1, 0, pct, 0)
        obj.hpFill.Position = UDim2.new(0, 0, 1 - pct, 0)
        obj.hpFill.BackgroundColor3 = pct > 0.6 and Color3.fromRGB(0, 255, 0)
            or pct > 0.3 and Color3.fromRGB(255, 255, 0)
            or Color3.fromRGB(255, 0, 0)
    end
end)

-- ═══════════════════════════════════════════════
-- AIMBOT
-- ═══════════════════════════════════════════════

local function findTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil, nil end
    local cx = cam.ViewportSize.X / 2
    local cy = cam.ViewportSize.Y / 2
    local bestPlr, bestPart, bestDist = nil, nil, CFG.aimFOV

    for _, plr in pairs(Players:GetPlayers()) do
        if plr == LP then continue end
        if plr == skipPlayer then continue end
        local ch = plr.Character
        if not ch then continue end
        local part = ch:FindFirstChild(CFG.aimPart)
            or ch:FindFirstChild("HumanoidRootPart")
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not part or not hum or hum.Health <= 0 then continue end
        local sp, onScreen = cam:WorldToViewportPoint(part.Position)
        if not onScreen then continue end
        local d = math.sqrt((sp.X - cx)^2 + (sp.Y - cy)^2)
        if d < bestDist then
            bestDist = d
            bestPlr = plr
            bestPart = part
        end
    end
    return bestPlr, bestPart
end

local function isTargetValid()
    if not lockPart or not lockPart.Parent then return false end
    if not lockPlayer or not lockPlayer.Parent then return false end
    local ch = lockPlayer.Character
    if not ch or not lockPart:IsDescendantOf(ch) then return false end
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local myChar = LP.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if myHRP then
        if (myHRP.Position - lockPart.Position).Magnitude > CFG.lockMaxDist then
            return false
        end
    end
    return true
end

RunService.RenderStepped:Connect(function(dt)
    if not aimOn then return end
    local cam = workspace.CurrentCamera
    if not cam then return end

    -- SWAP
    if swapRequest then
        swapRequest = false
        releaseLock()
        local plr, part = findTarget()
        if plr and part then
            lockPlayer = plr
            lockPart = part
            lockLost = 0
            print("[V23] 🔄 → LOCK:", plr.Name)
        else
            print("[V23] ⚠️ Không còn target")
        end
        skipPlayer = nil
        return
    end

    -- Chưa lock → tìm
    if not lockPart then
        if tick() - lastSearch > CFG.searchDelay then
            lastSearch = tick()
            local plr, part = findTarget()
            if plr and part then
                lockPlayer = plr
                lockPart = part
                lockLost = 0
                print("[V23] 🔒 LOCK:", plr.Name)
            end
        end
        return
    end

    -- Target không còn valid
    if not isTargetValid() then
        lockLost = lockLost + dt
        if lockLost > CFG.lockTimeout then
            releaseLock()
        end
        return
    end

    -- Aim
    lockLost = 0
    local ok = pcall(function()
        if CFG.hardLock then
            cam.CFrame = CFrame.lookAt(cam.CFrame.Position, lockPart.Position)
        else
            local targetCF = CFrame.new(cam.CFrame.Position, lockPart.Position)
            local smooth = 1 - math.exp(-CFG.aimSmooth * dt)
            smooth = math.clamp(smooth, 0.05, 0.95)
            cam.CFrame = cam.CFrame:Lerp(targetCF, smooth)
        end
    end)
    if not ok then releaseLock() end
end)

-- ═══════════════════════════════════════════════
-- RESPAWN / PLAYER LEAVE
-- ═══════════════════════════════════════════════

local respawnConnected = {}

local function connectRespawn(plr)
    if plr == LP or respawnConnected[plr] then return end
    respawnConnected[plr] = true
    plr.CharacterAdded:Connect(function()
        if plr == lockPlayer then releaseLock() end
        if espOn then
            task.wait(1)
            makeESP(plr)
        end
    end)
end

Players.PlayerAdded:Connect(connectRespawn)
Players.PlayerRemoving:Connect(function(plr)
    if plr == lockPlayer then releaseLock() end
    removeESP(plr)
    respawnConnected[plr] = nil
end)

for _, p in pairs(Players:GetPlayers()) do
    connectRespawn(p)
end

